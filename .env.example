# ==============================================================================
# RAHVIA PLATFORM - ENVIRONMENT CONFIGURATION (MVP TO SCALE)
# ==============================================================================

# Django Core
DEBUG=True
SECRET_KEY=change-me-to-a-cryptographically-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS & CSRF Configuration (Frontend domain linking)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Option A: Standard PostgreSQL URL (Render, Supabase, Neon, Railway)
# DATABASE_URL=postgresql://user:password@hostname:5432/rahvia_db?sslmode=require

# Option B: Discrete environment variables (Docker & local dev fallback)
USE_POSTGRES=False
POSTGRES_DB=rahvia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# Redis & Caching
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/1

# Security & Compliance (Pakistani PDPA & TLS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# AWS S3 Storage (Optional in production for PDF reports)
USE_AWS_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=rahvia-career-reports
AWS_S3_REGION_NAME=ap-south-1
